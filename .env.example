# ============================================================
# C:\Jarvis\.env — Jarvis Environment Configuration
# ============================================================
# IMPORTANT: Never commit this file to Git.
# Add .env to your .gitignore immediately.
# ============================================================

# ── Telegram ──────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat_id (numeric).
# How to find it: message @userinfobot on Telegram.
ALLOWED_CHAT_ID=123456789

# ── Ollama (Local AI) ─────────────────────────────────────
# Leave as default unless you changed Ollama's port
OLLAMA_URL=http://localhost:11434/api/generate

# The model you have pulled locally (ollama pull <model>)
# Options: llama3, mistral, phi3, gemma2, qwen2.5
OLLAMA_MODEL=llama3

# ── Notion (Memory Logging) ───────────────────────────────
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_integration_token_here

# Your Notion Database ID (32-char hex from the database URL)
# URL format: notion.so/workspace/<DATABASE_ID>?v=<VIEW_ID>
NOTION_DATABASE_ID=your_32_char_database_id_here
